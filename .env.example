# === Deployment (Pflicht) ===
APP_SLUG=prowiki
WEB_PORT=3000
FRONTEND_PORT=3084

# === Datenbank (Pflicht) ===
# DB_USER, DB_PASSWORD und AUTH_SECRET sind in docker-compose.yml als
# Pflichtvariablen deklariert (${VAR:?...}). Fehlt eine davon, bricht
# `docker compose up` ab – bewusst, damit die App nicht still mit einem
# Default-Secret aus dem Repository startet.
DB_USER=prowiki_app
DB_PASSWORD=changeme
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@pg-shared:5432/prowiki

# Lokale Entwicklung (docker-compose.dev.yml, Port 5433 wegen parallel
# laufendem knora):
# DATABASE_URL=postgresql://prowiki:prowiki-dev@localhost:5433/prowiki

# === Auth (Pflicht) ===
# Signiert Sitzungs-Cookies. Ohne diesen Wert bricht der Start ab.
AUTH_SECRET=<generiere mit: openssl rand -base64 32>

# Basis-URL der App – Ziel der Verifikations- und Einladungslinks und
# Grundlage der Cookie-Domain.
APP_BASE_URL=http://localhost:5173

# Erlaubte Absender, kommagetrennt. Kundendomänen kommen in Stufe 2 dazu.
# TRUSTED_ORIGINS=http://localhost:5173,https://prowiki.example

# HINWEIS: ADMIN_EMAIL / ADMIN_PASSWORD gibt es nicht mehr.
# In knora wurden diese Werte im Klartext gegen die Eingabe geprüft, noch vor
# jeder Datenbankabfrage, und wer die passende E-Mail benutzte, war Admin über
# alle Mandanten (Befund 2.1 in docs/KONZEPT.md). Betreiberrechte vergibt man
# jetzt über eine Zeile in `member`, nicht über eine Umgebungsvariable.

# === Parser (optional) ===
# Nur nötig, wenn PDF/DOCX geparst werden soll.
# PARSER_URL=http://parser:8000/parse
# Lokal: http://localhost:8002/parse

# === LLM Provider ===
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...

# === YouTube-Transkripte ===
# YouTube blockt Rechenzentrums-IPs; auf dem Server ist ein Provider nötig.
# YOUTUBE_TRANSCRIPT_PROVIDER=apify
# APIFY_API_KEY=...
# SUPADATA_API_KEY=...
# Für den Kanal-Import (Stufe 1), Backfill über die Uploads-Playlist:
# YOUTUBE_API_KEY=...
