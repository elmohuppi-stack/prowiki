# === Deployment (Pflicht) ===
APP_SLUG=prowiki

# Portblock 3121/3122 laut platform/ARCHITEKTUR.md 5. 3101/3102 stand hier
# früher und gehört wandervogel — vor jeder Vergabe gegenprüfen mit:
#   ssh elmarhepp 'grep -rh proxy_pass /etc/nginx/sites-available/ | sort -u'
# Genutzt wird nur 3121 (Frontend); die API liegt dahinter im selben Vhost
# unter /api/. 3122 bleibt reserviert, falls sie je eine eigene Domain bekommt.
FRONTEND_PORT=3121

# Lokale Entwicklung: das Backend lauscht auf PORT, der Vite-Proxy zeigt dorthin.
PORT=3102

# LLM-Provider liegen je Organisation in der Datenbank, nicht hier — jede
# Organisation trägt ihren eigenen Anbieter und Schlüssel ein ("bring your own
# key", KONZEPT 5.4, service/provider.ts). Die Schlüssel werden dabei mit einem
# aus AUTH_SECRET abgeleiteten Schlüssel verschlüsselt (service/crypto.ts).
#
# Dieser Schalter entscheidet nur, was passiert, wenn eine Organisation **keinen**
# aktiven Provider hat: 0 = kein Aufruf (Vorgabe), 1 = auf einen
# Plattform-Provider ausweichen (Zeile mit organization_id IS NULL).
# Vorgabe ist bewusst 0 — eine stille Umleitung auf einen fremden Anbieter in
# einem anderen Land ist schlimmer als eine ausbleibende Antwort.
ALLOW_PLATFORM_PROVIDER=0

# === Mailversand (optional, aber vor dem ersten Fremdkunden Pflicht) ===
#
# Ohne SMTP_HOST stehen Verifikations- und Passwort-Reset-Links nur im
# Container-Log. Für bekannte Nutzer tragbar — mit der Folge, dass ein
# vergessenes Passwort ohne SSH-Zugang zum Server nicht zurücksetzbar ist.
#
# Port 465 = implizites TLS, 587 = STARTTLS. Die Wahl folgt automatisch aus dem
# Port; ein falsch gesetztes `secure` ist der häufigste Grund, warum SMTP
# scheinbar grundlos nicht geht.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=prowiki <noreply@elmarhepp.de>

# Job-Warteschlange (pg-boss, Schema `pgboss` in derselben Datenbank).
#
# Der Worker läuft als eigener Container `prowiki-worker`. Beide Prozesse halten
# eigene Verbindungen; auf pg-shared teilen sich alle Apps `max_connections=100`
# (platform/ARCHITEKTUR.md 4.2). Die Vorgaben ergeben zusammen rund 14:
# API 8 + Worker 4 + pg-boss 2.
WORKER_DB_POOL_MAX=4
JOBS_POOL_MAX=2

# Ablage für hochgeladene Dateien zwischen API und Worker. Im Betrieb ein
# Docker-Volume (docker-compose.yml), lokal ein Verzeichnis. Flüchtig: der
# Worker löscht nach der Verarbeitung, Reste nach 24 Stunden.
SPOOL_DIR=./.spool

# Nach jeder Wiki-Generierung fehlende Embeddings nachziehen. Im Betrieb an
# (der Job hat einen singletonKey je Wiki, es überlagert sich nichts). Bei
# Massenläufen über das tools-Profil auf 0 — dort ist embed-backfill.ts am Ende
# des Laufs der schnellere Weg.
WIKI_EMBED_AFTER_GENERATE=1

# Kosten eines Transkriptabrufs in Millionstel Euro (40000 = 0,04 €). Wird je
# Abruf in usage_events geschrieben — anders als LLM-Aufrufe wird hier nicht
# nach Tokens abgerechnet, sondern je Video. Der echte Wert steht in der
# Abrechnung des gewählten Apify-Actors.
TRANSCRIPT_COST_MICROS=40000

# === Datenbank (Pflicht) ===
# Rolle ohne SUPERUSER/CREATEDB, eigene Datenbank in der gemeinsamen Instanz.
# Passwort erzeugen mit:  openssl rand -base64 24 | tr '+/' '-_'
# Das tr ist Pflicht: ein "/" im Passwort macht den Verbindungsstring als URL
# ungültig und die App scheitert erst beim ersten Verbindungsversuch.
DB_USER=prowiki
DB_PASSWORD=changeme
DB_NAME=prowiki

# max_connections = 100 gilt für alle Apps der Instanz zusammen. Richtwert für
# eine neue App: 5–10, danach nachmessen (platform/ARCHITEKTUR.md 4.2).
DB_POOL_MAX=8

# Lokale Entwicklung (docker-compose.dev.yml, Port 5434 wegen parallel
# laufendem knora):
# DATABASE_URL=postgresql://prowiki:prowiki-dev@localhost:5434/prowiki

# === Auth (Pflicht) ===
# Signiert Sitzungs-Cookies. Ohne diesen Wert bricht der Start ab.
AUTH_SECRET=<generiere mit: openssl rand -base64 32>

# Basis-URL der App – Ziel der Verifikations- und Einladungslinks und
# Grundlage der Cookie-Domain.
APP_BASE_URL=https://prowiki.elmarhepp.de

# Erlaubte Absender, kommagetrennt. Kundendomänen kommen in Stufe 2 dazu.
# TRUSTED_ORIGINS=https://prowiki.elmarhepp.de

# Selbstregistrierung. Standard 0 = zu (platform/NEUE-APP.md 4.1): sonst steht
# POST /api/auth/sign-up/email offen, auch ohne Link in der Oberfläche.
# Für den einmaligen Bootstrap der ersten Konten kurz auf 1 setzen,
# `docker compose up -d`, Konten anlegen, zurück auf 0.
ALLOW_SIGNUP=0

# HINWEIS: ADMIN_EMAIL / ADMIN_PASSWORD gibt es nicht mehr.
# In knora wurden diese Werte im Klartext gegen die Eingabe geprüft, noch vor
# jeder Datenbankabfrage, und wer die passende E-Mail benutzte, war Admin über
# alle Mandanten (Befund 2.1 in docs/KONZEPT.md). Betreiberrechte vergibt man
# jetzt über eine Zeile in `member`, nicht über eine Umgebungsvariable.

# === Migration knora → prowiki (einmalig) ===
# Nur für den Lauf von src/scripts/migrate-knora.ts setzen und danach wieder
# entfernen: die Zeile enthält die Zugangsdaten einer FREMDEN Datenbank und hat
# in prowikis .env dauerhaft nichts verloren. Ablauf in docs/LIVEGANG.md 5.
# SOURCE_DATABASE_URL=postgresql://knora_app:<pw>@pg-shared:5432/knora

# === Parser (optional) ===
# Nur nötig, wenn PDF/DOCX geparst werden soll. In Produktion setzt die
# Compose-Datei den Wert selbst auf http://prowiki-parser:8000/parse.
# Lokal: http://localhost:8002/parse

# === LLM Provider ===
# Nicht zwingend: Schlüssel liegen verschlüsselt in model_providers je
# Organisation ("bring your own key"). Diese Variablen sind der Notnagel.
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...

# === YouTube-Transkripte ===
# YouTube blockt Rechenzentrums-IPs; auf dem Server ist ein Provider nötig.
# YOUTUBE_TRANSCRIPT_PROVIDER=apify
# APIFY_API_KEY=...
# SUPADATA_API_KEY=...
# Für den Kanal-Import (Stufe 1), Backfill über die Uploads-Playlist:
# YOUTUBE_API_KEY=...
